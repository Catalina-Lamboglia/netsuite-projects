/**
 * @NApiVersion 2.1
 * @NModuleScope SameAccount
 * @description Agnostic RESTlet utilities for payload validation, idempotency checks, and error handling.
 */

define(['N/search', 'N/error'], (search, error) => {

    // Validates JSON payload
    // Throws a structured NetSuite error if validation fails.
    const validateRequiredFields = (payload, requiredFields) => {
        if (!payload || typeof payload !== 'object') {
            throw error.create({
                name: 'INVALID_PAYLOAD',
                message: 'Request body must be a valid JSON object.',
                notifyOff: true
            });
        }

        const missingFields = requiredFields.filter((field) => {
            const val = payload[field];
            return val === undefined || val === null || val === '';
        });

        if (missingFields.length > 0) {
            throw error.create({
                name: 'MISSING_REQUIRED_FIELDS',
                message: `Missing required payload field(s): ${missingFields.join(', ')}`,
                notifyOff: true
            });
        }
    };

    /**
     * Queries a NetSuite record type to check if an external ID has already been ingested.
     * Prevents duplicate record creation on webhook retries.
     *
     * @param {Object} params
     * @param {string} params.recordType - NetSuite record type ID (e.g., 'supportcase')
     * @param {string} params.externalIdField - Custom field ID storing the external system's ID
     * @param {string|number} params.externalIdValue - The incoming external ID to check
     * @returns {string|null} Existing NetSuite Internal ID if found, otherwise null
     */
    const findExistingRecordByExternalId = ({ recordType, externalIdField, externalIdValue }) => {
        let existingInternalId = null;

        const duplicateSearch = search.create({
            type: recordType,
            filters: [
                [externalIdField, 'is', String(externalIdValue)]
            ],
            columns: ['internalid']
        });

        duplicateSearch.run().each((result) => {
            existingInternalId = result.id;
            return false; // Stop after finding the first match
        });

        return existingInternalId;
    };

    return {
        validateRequiredFields,
        findExistingRecordByExternalId
    };
});
